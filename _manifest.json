{
  "manifest_version": 2,
  "id": "Rabbit-Jia-Er.MaiTrace",
  "version": "6.2.4",
  "name": "MaiTrace（麦时迹）",
  "description": "MaiBot 的生活与 QQ 空间插件：让麦麦拥有每日作息、精力心情、睡眠梦境，并在合适的时候分享近况。",
  "plugin_type": "chat",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png"
    }
  },
  "author": {
    "name": "Rabbit-Jia-Er",
    "url": "https://github.com/Rabbit-Jia-Er"
  },
  "license": "AGPL-3.0-only",
  "urls": {
    "repository": "https://github.com/Rabbit-Jia-Er/MaiTrace",
    "homepage": "https://github.com/Rabbit-Jia-Er/MaiTrace",
    "issues": "https://github.com/Rabbit-Jia-Er/MaiTrace/issues"
  },
  "host_application": {
    "min_version": "1.3.11",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24.0"
    },
    {
      "type": "python_package",
      "name": "beautifulsoup4",
      "version_spec": ">=4.12.0"
    },
    {
      "type": "python_package",
      "name": "json5",
      "version_spec": ">=0.9.0"
    },
    {
      "type": "python_package",
      "name": "tzdata",
      "version_spec": ">=2024.1"
    },
    {
      "type": "python_package",
      "name": "chinese-calendar",
      "version_spec": ">=1.11.0"
    },
    {
      "type": "python_package",
      "name": "lunar-python",
      "version_spec": ">=1.4.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "config.get",
    "config.get_plugin",
    "llm.generate",
    "message.get_by_time_in_chat",
    "chat.get_all_streams",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "emoji.get_by_description",
    "database.get",
    "api.call",
    "api.list",
    "knowledge.search",
    "render.html2png",
    "frequency.set_adjust",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
